{
  "name": "shiplog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @shiplog/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm build && pnpm --filter @shiplog/e2e e2e"
  },
  "engines": { "node": ">=20" }
}
